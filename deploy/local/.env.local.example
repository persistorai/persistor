# Local dev stack config — copy to `.env.local` and fill the public token.
#   cp deploy/local/.env.local.example deploy/local/.env.local
#
# .env.local is gitignored. These are the Stytch TEST project values (issuer ends
# in .stytch.dev, NOT the Live .stytch.com). The public token is publishable, not
# a secret, but it stays out of git anyway — grab it from Vault or the Stytch
# dashboard (Test env → API keys → public token, public-token-test-...).

PERSISTOR_OIDC_ISSUER=https://seemly-sunset-9833.customers.stytch.dev
PERSISTOR_OIDC_AUDIENCE=project-test-00000000-0000-0000-0000-000000000000
PERSISTOR_OIDC_JWKS_URL=https://seemly-sunset-9833.customers.stytch.dev/.well-known/jwks.json
PERSISTOR_STYTCH_PUBLIC_TOKEN=public-token-test-REPLACE-ME
