[Unit]
Description=Persistor remote MCP memory daemon (tailnet-bound)
Documentation=https://github.com/persistorai/persistor
After=network-online.target postgresql@18-persistorenc.service
Wants=network-online.target
# The DB lives on a MANUALLY-unlocked LUKS volume, so this unit is
# deliberately NOT enabled at boot. deploy/persistor-enc-unlock.sh unlocks the
# volume, starts the encrypted cluster, then starts this service; the lock
# script stops it. Restart=on-failure keeps it up while the volume is mounted.

[Service]
Type=simple
User=brian
Group=brian
ExecStart=/home/brian/.local/bin/persistor-server
Restart=on-failure
RestartSec=5

# Configuration lives outside the unit so no secrets are baked in. Copy
# deploy/persistor-server.env.example to ~/.persistor/server.env and fill it in.
# DATABASE_URL points at the encrypted cluster on :5434 (where at-rest
# protection comes from — disk/cluster LUKS encryption, reached over TCP). The
# daemon is file-less: it writes nothing to the filesystem.
EnvironmentFile=/home/brian/.persistor/server.env

# Hardening: the daemon needs only Postgres (TCP) — it writes nothing to disk,
# so the filesystem can stay fully read-only with no ReadWritePaths carve-out.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
