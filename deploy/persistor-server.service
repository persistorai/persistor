[Unit]
Description=Persistor remote MCP memory daemon (tailnet-bound)
Documentation=https://github.com/briancolinger/persistor
After=network-online.target postgresql@18-persistorenc.service
Wants=network-online.target
# The DB and notes live on a MANUALLY-unlocked LUKS volume, so this unit is
# deliberately NOT enabled at boot. deploy/persistor-enc-unlock.sh unlocks the
# volume, starts the encrypted cluster, then starts this service; the lock
# script stops it. Restart=on-failure keeps it up while the volume is mounted.

[Service]
Type=simple
User=user
Group=user
ExecStart=/home/user/.local/bin/persistor-server
Restart=on-failure
RestartSec=5

# Configuration lives outside the unit so no secrets are baked in. Copy
# deploy/persistor-server.env.example to ~/.persistor/server.env and fill it in
# (DATABASE_URL points at the encrypted instance on :5434; PERSISTOR_NOTES_DIR
# is on the encrypted mount so note files never touch unencrypted disk).
EnvironmentFile=/home/user/.persistor/server.env

# Hardening: the daemon needs Postgres (TCP) and its notes dir on the encrypted
# mount, nothing else. ProtectSystem=strict makes the FS read-only; carve out
# just the encrypted notes dir for memory_write.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/persistor-enc/notes
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
