# Persistor remote MCP daemon — environment template.
# Copy to ~/.persistor/server.env and fill in. NEVER commit the real file.

# Postgres. Connect as a NOSUPERUSER NOBYPASSRLS role — RLS is the tenant
# boundary, and a superuser/bypassrls role silently voids it (the pool refuses
# to start as one).
DATABASE_URL=postgres://persistor:CHANGEME@localhost:5432/persistor?sslmode=disable

# No PERSISTOR_TENANT_ID: the daemon resolves the tenant per request from the
# bearer token. Mint a key with:
#   persistor key create --tenant <tenant-uuid> --label laptop
# and give it to the client as `Authorization: Bearer <token>`. Use a THROWAWAY
# tenant for the build — never devbox's live memory tenant.

# Notes root (file-backed write path). Use a throwaway dir for the test;
# PG-native (file-less) multi-tenant serving arrives in a later phase.
PERSISTOR_NOTES_DIR=/home/user/persistor-remote-test

# Optional: where memory_write lands (default <PERSISTOR_NOTES_DIR>/memory/atomic).
# PERSISTOR_WRITE_DIR=

# Bind address. Phase P1 is tailnet-only: set this to this machine's Tailscale IP
# (run `tailscale ip -4`). The default 127.0.0.1:8088 is intentionally
# unreachable from other devices.
PERSISTOR_LISTEN_ADDR=100.64.0.1:8088
