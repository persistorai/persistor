# Persistor MCP daemon — environment template.
# Copy to ~/.persistor/server.env and fill in. NEVER commit the real file.
#
# Persistor is file-less: notes live in Postgres (the source of truth), so there
# is no notes directory to configure. Auth is OIDC, always — there is no static
# API-key mode.

# Postgres. Connect as a NOSUPERUSER NOBYPASSRLS role — RLS is the tenant
# boundary, and a superuser/bypassrls role silently voids it (the pool refuses
# to start as one). At-rest encryption is provided by the storage layer: point
# this at the cluster on the encrypted LUKS volume (by convention :5434), not the
# default system Postgres on :5432. The DB holds the FTS index and note bodies;
# disk/cluster encryption (LUKS self-host, RDS-at-rest hosted) is the at-rest
# answer — there is no application-level note encryption.
DATABASE_URL=postgres://persistor:CHANGEME@localhost:5434/persistor?sslmode=disable

# No PERSISTOR_TENANT_ID: the daemon resolves the tenant per request from the
# OIDC token (tenant = uuidv5(issuer|subject)), so the same identity maps to the
# same tenant on every device.

# Bind address. Tailnet-only by default: set this to this machine's Tailscale IP
# (run `tailscale ip -4`). The default 127.0.0.1:8088 is intentionally
# unreachable from other devices.
PERSISTOR_LISTEN_ADDR=100.64.0.1:8088

# Externally-visible base URL (resource id + metadata/consent URLs). Defaults to
# http://<PERSISTOR_LISTEN_ADDR>. Set explicitly behind a proxy.
# PERSISTOR_PUBLIC_URL=http://100.64.0.1:8088

# --- OIDC (required) -------------------------------------------------------
# Issuer + JWKS come from the IdP (Stytch). AUDIENCE is the value the IdP stamps
# into the token's `aud` — for Stytch this is the STYTCH PROJECT ID
# (project-test-... / project-live-...), NOT the resource/public URL. Decode a
# real token's `aud` to confirm. Issuer and JWKS must be HTTPS (loopback allowed
# for local testing).
PERSISTOR_OIDC_ISSUER=https://seemly-sunset-9833.customers.stytch.dev
PERSISTOR_OIDC_AUDIENCE=project-test-6d376bed-3e28-4959-85f1-395206636333
PERSISTOR_OIDC_JWKS_URL=https://seemly-sunset-9833.customers.stytch.dev/.well-known/jwks.json

# Publishable Stytch token (NOT a secret) — serves the /authorize consent page.
# PERSISTOR_STYTCH_PUBLIC_TOKEN=public-token-test-...

# --- Operational (optional) ------------------------------------------------
# Schema migrations. Default (unset/true) = the daemon applies migrations at boot
# and must connect as the schema owner (single-role self-host posture). Set false
# for the production split-role posture: migrate separately with
# `persistor migrate` as the owner, run the daemon as a non-owner app role (it
# then refuses to start against a stale schema or as the table owner). See
# deploy/sql/provision-roles.sql.
# PERSISTOR_AUTO_MIGRATE=false

# Connection pool size (default 8). Size to the box / RDS max_connections.
# PERSISTOR_DB_MAX_CONNS=8

# Log level: trace|debug|info|warn|error (default info).
# PERSISTOR_LOG_LEVEL=info

# Origin lock (public deployments behind Cloudflare only — leave unset for the
# tailnet bind). When set, every route except /healthz requires a matching
# X-Origin-Secret header, which a Cloudflare Transform Rule injects on proxied
# traffic. This makes the edge (WAF/rate limits) mandatory instead of bypassable
# via the bare origin host, and switches the per-IP limiters to the real client
# IP (CF-Connecting-IP). Generate with: openssl rand -hex 32
# PERSISTOR_ORIGIN_SECRET=

# Dynamic Client Registration relay (default true). /register proxies OAuth
# client registration to the IdP unauthenticated — claude.ai web connectors need
# it to onboard. Set false to shut it off if abused: existing clients keep
# working, new connector setups fail at discovery (endpoint is also dropped from
# the AS metadata). Every registration attempt is logged.
# PERSISTOR_DCR_ENABLED=true

# /metrics tenant allowlist (comma-separated tenant UUIDs). Empty = any valid
# token may read it (fine single-user). Set on public deployments with open
# provisioning, where "valid token" is not "operator" — /metrics exposes global
# DB pool saturation. Find your tenant id with `persistor admin`.
# PERSISTOR_METRICS_TENANTS=

# Subject allowlist (comma-separated IdP subjects). Empty = OPEN: any valid
# token from the pinned issuer authenticates and auto-provisions a tenant. Set
# to lock a single-user/invite-only deployment — only these subjects are
# accepted, checked before any tenant is provisioned. Find your subject after a
# first login: `persistor admin identity list` (the `subject` column) or the
# Stytch dashboard → Users.
# PERSISTOR_ALLOWED_SUBJECTS=
