# Persistor — local configuration for the `persistor` operator CLI.
# Persistor is file-less: notes live in Postgres (the source of truth), so the
# CLI needs only a Postgres connection and a tenant. The remote MCP daemon
# (persistor-server) has its own config — see deploy/persistor-server.env.example.

# sslmode=disable is for a LOOPBACK dev DB only. For any remote/hosted database
# use sslmode=require (or verify-full) — never ship unencrypted DB transport.
#
# The CLI is the operator path and may connect as the schema-owning migrator
# role (it can apply migrations via `persistor migrate`). The daemon, by
# contrast, should connect as a non-owner NOSUPERUSER NOBYPASSRLS role; the pool
# refuses to start as a superuser/bypassrls role either way.
DATABASE_URL=postgres://persistor:changeme@localhost:5432/persistor?sslmode=disable

# Tenant UUID for the CLI's tenant-scoped commands (search, brief, list, export,
# import, …). The --tenant flag overrides this. The daemon does NOT use this —
# it resolves the tenant per request from the OIDC token.
#   PERSISTOR_TENANT_ID=<uuid>
