# Persistor — local configuration.
# The index needs only a Postgres connection: no embedding model, no encryption
# keys, no server ports.

# sslmode=disable is for a LOOPBACK dev DB only. For any remote/hosted database
# use sslmode=require (or verify-full) — never ship unencrypted DB transport.
# Connect as a NOSUPERUSER NOBYPASSRLS role; NewPool refuses to start otherwise.
DATABASE_URL=postgres://persistor:changeme@localhost:5432/persistor?sslmode=disable

# Used by the CLI and stdio MCP server (flags override these):
#   PERSISTOR_TENANT_ID=<uuid>
#   PERSISTOR_NOTES_DIR=/path/to/notes/repo
#   PERSISTOR_WRITE_DIR=/path/to/notes/repo/memory/atomic   # optional; where consolidate writes
#   CLAUDE_MEMORY_DIR=/path/to/claude/auto-memory           # optional; indexed alongside the notes repo

# The remote MCP HTTP daemon (persistor-server) has its own config — listen
# address, auth mode, and the OIDC/Stytch settings (PERSISTOR_LISTEN_ADDR,
# PERSISTOR_AUTH_MODE, PERSISTOR_PUBLIC_URL, PERSISTOR_OIDC_ISSUER/_AUDIENCE/
# _JWKS_URL, PERSISTOR_STYTCH_PUBLIC_TOKEN). See deploy/persistor-server.env.example.
